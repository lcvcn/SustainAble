<?xml version="1.0" encoding="UTF-8"?>
<xs:schema 
    xmlns:xs="http://www.w3.org/2001/XMLSchema" 
    xmlns="http://www.example.org/document"
    targetNamespace="http://www.example.org/document"
    elementFormDefault="qualified">

    <xs:element name="Document">
        <xs:complexType>
            <xs:sequence>
                
                <!-- METADATA -->
                <xs:element name="Metadata">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="Title" type="xs:string"/>
                            <xs:element name="Authors">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="Author" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="Name" type="xs:string"/>
                                                    <xs:element name="Affiliation" type="xs:string"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="PublicationDate" type="xs:date"/>
                            <xs:element name="Keywords">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="Keyword" type="xs:string" maxOccurs="unbounded"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="Description" type="xs:string"/>
                            <xs:element name="License" type="xs:anyURI"/>
                            <xs:element name="Language" type="xs:string"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <!-- HEADLINE -->
                <xs:element name="Headline" type="xs:string"/>
                <xs:element name="IntroMessage" type="xs:string"/>

                <!-- CORPO -->
                <xs:element name="Body">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="Section" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="SectionTitle" type="xs:string"/>
                                        <xs:element name="Paragraph" type="xs:string" maxOccurs="unbounded"/>
                                        <xs:element name="Image" minOccurs="0">
                                            <xs:complexType>
                                                <xs:attribute name="src" type="xs:string" use="required"/>
                                                <xs:attribute name="alt" type="xs:string" use="required"/>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                    <xs:attribute name="id" type="xs:string" use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <!-- SUGGERIMENTI -->
                <xs:element name="Suggestion" minOccurs="0" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="Description" type="xs:string"/>
                            <xs:element name="Reason">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="Detail" type="xs:string" maxOccurs="unbounded"/>
                                        <xs:element name="Source" type="xs:string" minOccurs="0"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="HowTo">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="Step" type="xs:string" maxOccurs="unbounded"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                        <xs:attribute name="id" type="xs:string" use="required"/>
                    </xs:complexType>
                </xs:element>

                <!-- BIBLIOGRAFIA -->
                <xs:element name="Bibliography">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="Reference" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="Title" type="xs:string"/>
                                        <xs:element name="Authors">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="Author" type="xs:string" maxOccurs="unbounded"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="Publication" type="xs:string"/>
                                        <xs:element name="Volume" type="xs:string"/>
                                        <xs:element name="Year" type="xs:positiveInteger"/>
                                        <xs:element name="DOI" type="xs:string"/>
                                        <xs:element name="URL" type="xs:anyURI"/>
                                        <xs:element name="AccessDate" type="xs:date"/>
                                    </xs:sequence>
                                    <xs:attribute name="id" type="xs:string" use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>

